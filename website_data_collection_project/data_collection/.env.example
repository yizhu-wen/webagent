# Required by experiment prompts and runners. Use an HTTPS URL in production.
WEBSITE_BASE_URL=http://localhost:34567
WEBSITE_DOMAIN=localhost:34567

# Required by runners that monitor the production PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required when using Skyvern.
SKYVERN_API_KEY=

# Provider keys depend on the Browser Use or Skyvern model configuration.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
